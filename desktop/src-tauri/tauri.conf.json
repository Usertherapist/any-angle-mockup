{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Any Angle Mockup",
  "version": "1.0.0",
  "identifier": "com.mohhos.anyanglemockup",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "node scripts/build-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Any Angle Mockup",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "category": "public.app-category.graphics-design",
    "shortDescription": "3D mockups with real lens and depth of field",
    "copyright": "© 2026 Mohammad Hossein",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
